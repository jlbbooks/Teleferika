{
  "dart.flutterRunAdditionalArgs": [
    "--device-timeout=60"
  ],
  "dart.debugExtensionVersion": "3.50.0",
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.dart_tool/**": true
  },
  "dart.showDartDeveloperLogs": false,
  "dart.openDevTools": "flutter",
  "dart.flutterSdkPath": ".fvm/flutter_sdk",
  "dart.env": {
    "ANDROID_HOME": "/home/michael/.AndroidStudio_sdk",
    "ANDROID_SDK_ROOT": "/home/michael/.AndroidStudio_sdk",
    "ANDROID_USER_HOME": "/home/michael/.local/share/android",
    "ANDROID_AVD_HOME": "/home/michael/.local/share/android/avd"
  },
  "java.compile.nullAnalysis.mode": "automatic",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/usr/lib/jvm/java-21-openjdk",
      "default": true
    }
  ]
}
